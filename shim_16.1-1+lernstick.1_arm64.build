find /root/shim -type f -a '(' -iname '*.c' -o -iname '*.h' -o -iname '*.S' ')' | while read file ; do \
	outfile=$(echo ${file} | sed -e "s,^/root/shim,,") ; \
	install -d -m 0755 /root/shim/debian/tmp//usr/src/debug//shim-16.1-16.1/$(dirname ${outfile}) ; \
	install -m 0644 ${file} /root/shim/debian/tmp//usr/src/debug//shim-16.1-16.1/${outfile} ; \
done
install -d -m 0755 /root/shim/debian/tmp/
install -d -m 0700 /root/shim/debian/tmp/boot/efi/
